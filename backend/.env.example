# Copilot LLM provider: gemini | ollama | openai
LLM_PROVIDER=gemini

# Gemini (Google AI Studio free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local, offline): https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Any OpenAI-compatible endpoint (e.g. local proxy / LiteLLM)
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=

# NOAA SWPC data root
NOAA_BASE_URL=https://services.swpc.noaa.gov/json
CACHE_TTL_SECONDS=60
