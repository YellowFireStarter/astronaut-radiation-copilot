# Copilot LLM provider: gemini | ollama | openai
LLM_PROVIDER=gemini

# Gemini (Google AI Studio free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# Ollama (local, offline): https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Any OpenAI-compatible endpoint (e.g. local proxy / LiteLLM)
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=

# --- NOAA SWPC data root ---
NOAA_BASE_URL=https://services.swpc.noaa.gov/json
CACHE_TTL_SECONDS=60

# --- NOAA SWPC endpoint paths (relative to NOAA_BASE_URL) ---
NOAA_KP_PATH=planetary_k_index_1m.json
NOAA_MAG_PATH=rtsw/rtsw_mag_1m.json
NOAA_WIND_PATH=rtsw/rtsw_wind_1m.json
NOAA_PROTON_PATH=goes/primary/integral-protons-6-hour.json
NOAA_XRAY_PATH=goes/primary/xray-flares-latest.json

# --- Copilot API route paths (API contract; frontend/MCP must match) ---
ROUTE_ROOT=/
ROUTE_HEALTH=/health
ROUTE_TELEMETRY_LATEST=/api/telemetry/latest
ROUTE_LIMITS=/api/limits
ROUTE_DOSE_FORECAST=/api/dose/forecast
ROUTE_RISK_ASSESS=/api/risk/assess
ROUTE_BRIEF_GENERATE=/api/brief/generate
ROUTE_SPE_ALERT=/api/spe/alert
ROUTE_SPE_FORECAST=/api/spe/forecast
ROUTE_FLUX=/api/telemetry/flux
ROUTE_KP=/api/telemetry/kp
ROUTE_PLAN=/api/plan

# --- CORS (comma-separated origins; * = all) ---
CORS_ORIGINS=*
# SPE dose model: mSv per (pfu * hour), see dose_engine.py
SPE_DOSE_COEFFICIENT=2e-6
