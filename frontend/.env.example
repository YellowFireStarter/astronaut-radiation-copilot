# Backend target for the Vite dev proxy (frontend calls /api/* and /health).
# Copy to frontend/.env and adjust if your backend runs elsewhere.
VITE_API_TARGET=http://localhost:8000

# Backend route paths consumed by the dashboard (must match backend ROUTE_*).
# VITE_ROUTE_HEALTH=/health
# VITE_ROUTE_TELEMETRY_LATEST=/api/telemetry/latest
# VITE_ROUTE_LIMITS=/api/limits
# VITE_ROUTE_SPE_ALERT=/api/spe/alert
# VITE_ROUTE_FLUX=/api/telemetry/flux
# VITE_ROUTE_KP=/api/telemetry/kp
# VITE_ROUTE_DOSE_FORECAST=/api/dose/forecast
# VITE_ROUTE_PLAN=/api/plan
# VITE_ROUTE_BRIEF_GENERATE=/api/brief/generate
