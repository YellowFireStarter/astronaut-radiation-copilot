# Absolute path to your local checkout of the project.
# Copy this file to mcp/.env and set PROJECT to YOUR absolute project path.
# test_client.py uses it to locate the backend virtualenv and spawn mcp_server.py.
# It can also be supplied via the PROJECT environment variable (wins over .env).
PROJECT=C:\path\to\astronaut-radiation-copilot

# Backend REST API base URL used by mcp_server.py.
BACKEND_URL=http://localhost:8000

# Optional: backend route paths (must match the backend ROUTE_* settings).
# COPILOT_ROUTE_TELEMETRY_LATEST=/api/telemetry/latest
# COPILOT_ROUTE_SPE_ALERT=/api/spe/alert
# COPILOT_ROUTE_FLUX=/api/telemetry/flux
# COPILOT_ROUTE_KP=/api/telemetry/kp
# COPILOT_ROUTE_DOSE_FORECAST=/api/dose/forecast
# COPILOT_ROUTE_RISK_ASSESS=/api/risk/assess
# COPILOT_ROUTE_PLAN=/api/plan
# COPILOT_ROUTE_BRIEF_GENERATE=/api/brief/generate
